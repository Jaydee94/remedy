# Save as /etc/sudoers.d/remedy with: sudo visudo -f /etc/sudoers.d/remedy
# Read every line. Check the paths first: command -v docker; command -v systemctl
# Remedy runs sudo -n -- docker ... by name; sudo finds it through its own secure_path, so the path in these lines must be where sudo finds docker.
# Reading the journal needs the group systemd-journal, not sudo.
# In sudoers a * also matches spaces and further arguments, so a pattern with a star limits less than it looks.
# A name without a star is an exact match.
# docker ps -a is granted only with the filter below, so sudo itself refuses a list of every container of the host.
remedy ALL=(root) NOPASSWD: /usr/bin/docker ps -a --filter name\=^remedy-
remedy ALL=(root) NOPASSWD: /usr/bin/docker logs --tail * remedy-*
remedy ALL=(root) NOPASSWD: /usr/bin/docker inspect remedy-*
remedy ALL=(root) NOPASSWD: /usr/bin/docker start remedy-*, /usr/bin/docker restart remedy-*, /usr/bin/docker stop remedy-*
remedy ALL=(root) NOPASSWD: /usr/bin/systemctl start node_exporter.service, /usr/bin/systemctl restart node_exporter.service, /usr/bin/systemctl stop node_exporter.service
